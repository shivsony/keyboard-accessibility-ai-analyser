# Keyboard Accessibility AI Analyzer — environment template
#
# Copy to .env.local and fill in your own values:
#     cp .env.example .env.local
#
# .env* is git-ignored (this file is the only exception). Never commit a real
# key. Never prefix any of these with NEXT_PUBLIC_ — that would ship the value
# to the browser. See SECURITY.md.
#
# PLACEHOLDERS ONLY. No real credential belongs in this file, ever.

# ---------------------------------------------------------------------------
# AI provider (required) — you bring your own key.
# ---------------------------------------------------------------------------

# Which provider to use. "openai" is the only one supported today.
AI_PROVIDER=openai

# OpenAI API key. Read server-side only, never sent to the browser.
# Get one at https://platform.openai.com/api-keys
# Without it the audit refuses to start:
#   "AI provider is not configured. Set OPENAI_API_KEY."
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model used for the agent's decision step. Needs structured outputs, and
# vision if you want the agent to see screenshots.
OPENAI_MODEL=gpt-4o-mini

# How often the model is consulted.
#   decision-points  Code sweeps the page; the model is asked only where a
#                    judgement is required. A clean page may cost no calls at
#                    all. (default)
#   every-step       The model chooses every keypress. ~10x the calls and ~10x
#                    the tokens; kept so the two can be compared.
AI_MODE=decision-points

# Screenshot fidelity. "low" is a flat 85 tokens per image; "high" tiles a
# 1280x800 viewport into roughly 1,105. Low still conveys layout and reading
# order, which is what a focus-order judgement needs.
AI_IMAGE_DETAIL=low

# Whether screenshots are sent at all: "required" or "text-only".
# "required" fails a step whose screenshot is missing rather than quietly
# continuing text-only and reporting as though the agent had seen the page.
AI_IMAGE_MODE=required

# ---------------------------------------------------------------------------
# Agent run limits (optional — defaults shown).
# ---------------------------------------------------------------------------

# Hard ceiling on loop iterations. Guarantees a run terminates regardless of
# what the model decides.
AGENT_MAX_STEPS=150

# Milliseconds to wait for the page to settle after a keypress before observing.
AGENT_SETTLE_MS=250

# ---------------------------------------------------------------------------
# Browser (optional — defaults shown).
# ---------------------------------------------------------------------------

# Run Chromium headless. Set to false to watch the agent work.
BROWSER_HEADLESS=true

# Viewport used for observation and screenshots.
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=800

# ---------------------------------------------------------------------------
# Evidence output (optional — defaults shown).
# ---------------------------------------------------------------------------

# Directory for run artifacts: screenshots, step logs, findings.
# Git-ignored. Never write a credential here — run directories get attached to
# bug reports.
EVIDENCE_DIR=./artifacts
