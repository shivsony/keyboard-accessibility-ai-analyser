# Keyboard Accessibility AI Analyzer — environment template
#
# Copy to .env.local and fill in your own values:
#     cp .env.example .env.local
#
# .env* is git-ignored (this file is the only exception). Never commit a real
# key. Never prefix any of these with NEXT_PUBLIC_ — that would ship the value
# to the browser. See SECURITY.md.
#
# PLACEHOLDERS ONLY. No real credential belongs in this file, ever.

# ---------------------------------------------------------------------------
# AI provider (required) — you bring your own key.
# ---------------------------------------------------------------------------

# Which provider to use: "openai" or "groq".
# Both keys may sit in this file; this line decides which is used.
AI_PROVIDER=openai

# --- OpenAI -----------------------------------------------------------------
# Read server-side only. Get one at https://platform.openai.com/api-keys
# Without it the audit refuses to start:
#   "AI provider is not configured. Set OPENAI_API_KEY."
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Needs structured outputs, and vision to see screenshots.
OPENAI_MODEL=gpt-4o

# --- Groq -------------------------------------------------------------------
# An OpenAI-compatible endpoint, so it uses the same provider with a different
# base URL. Get a key at https://console.groq.com/keys
#
# NOTE: gpt-oss-120b is TEXT-ONLY. With AI_PROVIDER=groq the agent works from
# the accessibility tree and DOM alone, and the report records
# `multimodal: false`. It cannot notice that a control is visually first and
# focused last. That is a real reduction in what it can find — cheaper, not
# equivalent.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Override whether screenshots are sent: "required" or "text-only".
# Defaults to required for OpenAI, text-only for Groq. Setting "required"
# against a model without vision fails every step rather than silently
# dropping the image.
# AI_IMAGE_MODE=text-only

# ---------------------------------------------------------------------------
# Agent run limits (optional — defaults shown).
# ---------------------------------------------------------------------------

# Hard ceiling on loop iterations. Guarantees a run terminates regardless of
# what the model decides.
AGENT_MAX_STEPS=150

# Milliseconds to wait for the page to settle after a keypress before observing.
AGENT_SETTLE_MS=250

# ---------------------------------------------------------------------------
# Browser (optional — defaults shown).
# ---------------------------------------------------------------------------

# Run Chromium headless. Set to false to watch the agent work.
BROWSER_HEADLESS=true

# Viewport used for observation and screenshots.
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=800

# ---------------------------------------------------------------------------
# Evidence output (optional — defaults shown).
# ---------------------------------------------------------------------------

# Directory for run artifacts: screenshots, step logs, findings.
# Git-ignored. Never write a credential here — run directories get attached to
# bug reports.
EVIDENCE_DIR=./artifacts
